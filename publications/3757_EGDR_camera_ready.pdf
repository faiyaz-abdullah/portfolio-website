/ItalicAngle 0 def
/isFixedPitch false def
/UnderlinePosition -100 def
/UnderlineThickness 50 def
end readonly def
/Encoding 256 array
0 1 255 {1 index exch /.notdef put} for
dup 91 /bracketleft put
dup 93 /bracketright put
dup 99 /c put
dup 94 /circumflex put
dup 101 /e put
dup 61 /equal put
dup 11 /ff put
dup 111 /o put
dup 49 /one put
dup 40 /parenleft put
dup 41 /parenright put
dup 43 /plus put
dup 115 /s put
dup 48 /zero put
readonly def
currentdict end
currentfile eexec
